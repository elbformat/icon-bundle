{
  "name": "elbformat/icon-bundle",
  "description": "Ibexa fieldtype to select an icon from a predefined set.",
  "type": "symfony-bundle",
  "license": "MIT",
  "keywords": [
    "ibexa",
    "icon",
    "field-type"
  ],
  "authors": [
    {
      "name": "Hannes Giesenow",
      "email": "hannes.giesenow@format-h.com",
      "role": "Lead Developer"
    }
  ],
  "autoload": {
    "psr-4": {
      "Elbformat\\IconBundle\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Elbformat\\IconBundle\\Tests\\": "tests/"
    }
  },
  "require": {
    "php": ">=8.3",
    "ibexa/admin-ui": "^4.6 | ^5.0",
    "ibexa/core": "^4.6 | ^5.0",
    "symfony/finder": "^5.4 | ^6.4 | ^7.4"
  },
  "require-dev": {
    "phpstan/phpstan": "^2.1",
    "phpunit/phpunit": "^9.6"
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": {
      "symfony/runtime": true,
      "composer/package-versions-deprecated": true,
      "php-http/discovery": false,
      "symfony/flex": true,
      "ibexa/post-install": true
    },
    "policy": {
      "advisories": {
        "ignore": [
          "guzzlehttp/guzzle",
          "league/flysystem"
        ]
      }
    }
  }
}
